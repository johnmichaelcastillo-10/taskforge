# LF everywhere, so scripts and config behave the same in Linux containers whichever OS
# checked the repository out.
* text=auto eol=lf

# Windows-only helpers keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff2 binary
*.db binary
