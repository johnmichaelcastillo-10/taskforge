# Copy to .env and adjust. Never commit .env.
#   PowerShell: Copy-Item .env.example .env
#   Bash:       cp .env.example .env

# Host ports: the app container, and the live-reload dev server (compose profile "dev").
APP_PORT=8094
DEV_PORT=3000

# Linux only, if `id -u` / `id -g` aren't 1000: the user the dev container runs as.
# DEV_UID=1000
# DEV_GID=1000

# Encrypts session cookies; at least 32 characters. Optional locally: each container generates
# its own on the first start and keeps it in its data folder. Required in production.
NUXT_SESSION_PASSWORD=

# Sign-up. Off by default in the app container (demo accounts only), on in the dev server.
# NUXT_PUBLIC_REGISTRATION_ENABLED=false

# How long a demo workspace lives, in hours.
# NUXT_DEMO_TTL_HOURS=72

# Read visitors' addresses from X-Forwarded-For (for rate limits). Only behind a proxy that
# sets it, such as Vercel: anywhere else it could be forged. See docs/DEPLOY.md.
# NUXT_TRUST_PROXY=false

# Where the download page links for the desktop installers, such as a releases page.
# NUXT_PUBLIC_DOWNLOADS_URL=

# Database for running the app outside Docker. Docker sets its own path on a named volume.
# Production uses Turso: libsql://<database>.turso.io plus an auth token.
NUXT_DATABASE_URL=file:./data/taskforge.db
NUXT_DATABASE_AUTH_TOKEN=
